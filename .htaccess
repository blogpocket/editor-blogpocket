# =========================================================
#  Editor Blogpocket — .htaccess de la carpeta del editor
# =========================================================

# ---------- Acceso protegido con contraseña ----------
# Lo más sencillo: en cPanel → «Privacidad de directorios» (Directory Privacy),
# entra en la carpeta donde subiste el editor, marca «Proteger con contraseña»
# y crea tu usuario. cPanel añade aquí solo las líneas AuthType/AuthUserFile.
#
# Si prefieres hacerlo a mano, descomenta estas cuatro líneas, cambia la ruta
# y crea el archivo de contraseñas FUERA de public_html (ver README.md):
#
# AuthType Basic
# AuthName "Editor"
# AuthUserFile "/home/TU_USUARIO/.htpasswds/editor/passwd"
# Require valid-user

# ---------- Que no lo indexe nadie ----------
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>

# ---------- Cabeceras de seguridad ----------
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob: https:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
</IfModule>

# ---------- Caché: el service worker se encarga del modo sin conexión ----------
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "^sw\.js$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.png$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType application/javascript .js
  AddCharset utf-8 .js .css .json .html .md
</IfModule>

# ---------- Nada de listados de carpetas ----------
Options -Indexes

# ---------- Bloquea archivos que no deben servirse ----------
<FilesMatch "^(README\.md|LICENSE|THIRD-PARTY-NOTICES\.md|CHANGELOG\.md|\.ht.*|\.git.*|\.nojekyll)$">
  Require all denied
</FilesMatch>
